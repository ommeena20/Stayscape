<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="/css/gallery.css">

<div class="gallery-header">
  <h1 class="plus-jakarta">About Wonderlust</h1>
  <p class="text-muted">Helping you find your next place to wander</p>
</div>

<div class="container" style="max-width: 700px; padding-bottom: 60px;">

  <p class="desc">
    Wonderlust is a platform built for travelers who want more than just

<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-md-5 col-11 mx-auto">

    <div class="card border-0 shadow-lg rounded-4 p-4">

      <h2 class="text-center plus-jakarta mb-4">Welcome Back</h2>

      <form class="needs-validation" method="post" action="/login" novalidate>

        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Email</label>
          <input
            class="form-control rounded-3 py-2"
            id="username"
            name="username"
            type="text"
            placeholder="you@example.com"
            required
          >
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <input
            class="form-control rounded-3 py-2"
            id="password"
            name="password"
            type="password"
            placeholder="Enter your password"
            required
          >
        </div>

        <button class="btn btn-dark w-100 rounded-3 py-2" type="submit">
          Log In
        </button>

      </form>

    </div>

  </div>
</div>